MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=tiendataudio
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: enables the public RAG-lite audio assistant. Keep the key server-side only.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Phase 0 deterministic business/product facts. Set false for module-only rollback.
ASSISTANT_EXACT_FACTS_ENABLED=true
# Safe rollout: off | admin_only | exact_public | knowledge_public | graph_shadow | graph_public | advisor_public
ASSISTANT_ROLLOUT_MODE=knowledge_public
ASSISTANT_KNOWLEDGE_ENABLED=true
ASSISTANT_ADVISOR_ENABLED=false
ASSISTANT_CONVERSATIONS_ENABLED=true
ASSISTANT_RETENTION_DAYS=30
# Optional dedicated secret; SESSION_SECRET is used as fallback.
ASSISTANT_SESSION_SECRET=
# Optional Neo4j projection. HTTPS is mandatory except loopback development.
ASSISTANT_GRAPH_ENABLED=false
ASSISTANT_GRAPH_ADMIN_WRITES_ENABLED=false
NEO4J_HTTP_URL=
NEO4J_DATABASE=neo4j
NEO4J_READER_USERNAME=
NEO4J_READER_PASSWORD=
NEO4J_WRITER_USERNAME=
NEO4J_WRITER_PASSWORD=
# Optional: enables IndexNow notifications for Bing and participating engines.
INDEXNOW_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
UPLOAD_DIR=
SOCIAL_FACEBOOK_WORKER_ENABLED=false
# Optional local-only Playwright state; must be under .local/facebook and never be committed.
SOCIAL_FACEBOOK_STORAGE_STATE_PATH=
# Optional local-only CDP bridge to the already-open Chrome profile; bind to loopback only.
SOCIAL_FACEBOOK_CDP_ENABLED=false
SOCIAL_FACEBOOK_CDP_ACTIVE_PORT_PATH=
