MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=tiendataudio
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: enables IndexNow notifications for Bing and participating engines.
INDEXNOW_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
UPLOAD_DIR=
SOCIAL_FACEBOOK_WORKER_ENABLED=false
# Optional local-only Playwright state; must be under .local/facebook and never be committed.
SOCIAL_FACEBOOK_STORAGE_STATE_PATH=
# Optional local-only CDP bridge to the already-open Chrome profile; bind to loopback only.
SOCIAL_FACEBOOK_CDP_ENABLED=false
SOCIAL_FACEBOOK_CDP_ACTIVE_PORT_PATH=
